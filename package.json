{
    "name": "opinionated-machine-monorepo",
    "version": "0.0.0",
    "description": "Workspace root for opinionated-machine and its adapter packages",
    "type": "module",
    "license": "MIT",
    "private": true,
    "packageManager": "pnpm@11.14.0",
    "scripts": {
        "build:all": "turbo run build",
        "lint": "biome check .",
        "lint:all": "turbo run lint",
        "lint:fix": "biome check --write .",
        "test:all": "turbo run test",
        "changeset": "changeset",
        "ci:publish": "changeset publish"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kibertoad/opinionated-machine.git"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.10",
        "@changesets/cli": "^3.0.0",
        "@lokalise/biome-config": "^3.1.1",
        "@lokalise/tsconfig": "^3.1.0",
        "@types/node": "^22.19.7",
        "turbo": "2.10.12",
        "typescript": "^5.9.3",
        "vitest": "^4.0.18"
    }
}
