{
    "name": "opinionated-machine",
    "version": "11.0.0",
    "description": "Very opinionated DI framework for fastify, built on top of awilix ",
    "type": "module",
    "license": "MIT",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": "./dist/index.js",
        "./package.json": "./package.json"
    },
    "maintainers": [
        {
            "name": "Igor Savin",
            "email": "kibertoad@gmail.com"
        }
    ],
    "scripts": {
        "build": "rimraf dist && tsc -p tsconfig.build.json",
        "lint": "biome check . && tsc",
        "lint:fix": "biome check --write .",
        "test": "vitest --typecheck",
        "test:ci": "pnpm run test --coverage",
        "prepublishOnly": "pnpm run build"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kibertoad/opinionated-machine.git",
        "directory": "packages/opinionated-machine"
    },
    "dependencies": {
        "@fastify/sse": "^0.6.0",
        "@opinionated-machine/sse-parser": "workspace:*",
        "fast-querystring": "^1.1.2",
        "fastify-plugin": "^6.0.0",
        "ts-deepmerge": "^8.0.0"
    },
    "peerDependencies": {
        "@lokalise/api-contracts": ">=8.0.0",
        "@lokalise/fastify-api-contracts": ">=7.0.0",
        "@lokalise/node-core": ">=14.7.4",
        "awilix": ">=13.0.0",
        "awilix-manager": ">=6.0.0",
        "fastify": ">=5.0.0",
        "fastify-type-provider-zod": ">=7.0.0",
        "zod": ">=4.1.12"
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.4",
        "@lokalise/api-contracts": "^8.0.0",
        "@lokalise/biome-config": "^3.1.1",
        "@lokalise/fastify-api-contracts": "^7.0.0",
        "@lokalise/node-core": "^14.7.4",
        "@lokalise/tsconfig": "^3.1.0",
        "@opinionated-machine/sse-fallback": "workspace:*",
        "@types/node": "^22.19.7",
        "@vitest/coverage-v8": "^4.0.18",
        "awilix": "^13.0.0",
        "awilix-manager": "^7.0.0",
        "fastify": "^5.7.4",
        "fastify-type-provider-zod": "^7.0.0",
        "rimraf": "^6.1.2",
        "typescript": "^5.9.3",
        "vitest": "^4.0.18",
        "zod": "^4.3.6"
    },
    "private": false,
    "publishConfig": {
        "access": "public"
    },
    "keywords": [
        "dependency",
        "injection",
        "opinionated",
        "awilix",
        "di",
        "fastify"
    ],
    "homepage": "https://github.com/kibertoad/opinionated-machine/tree/main/packages/opinionated-machine",
    "files": [
        "README.md",
        "CHANGELOG.md",
        "LICENSE",
        "dist/*"
    ]
}
